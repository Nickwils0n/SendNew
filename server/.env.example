# Railway will inject DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL="postgresql://user:password@host:5432/sendnew"

# Long random string — used to sign device JWTs.
JWT_SECRET="change-me-to-a-long-random-string"

# Shared secret you (the operator) use to call /admin/* endpoints from your
# own tooling — never expose this to the CRM website or the agent app.
ADMIN_SECRET="change-me-to-a-long-random-string"

PORT=3000
