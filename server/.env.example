# Railway will inject DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL="postgresql://user:password@host:5432/sendnew"

# Long random string — used to sign device JWTs.
JWT_SECRET="change-me-to-a-long-random-string"

# Shared secret you (the operator) use to call /admin/* endpoints from your
# own tooling — never expose this to the CRM website or the agent app.
ADMIN_SECRET="change-me-to-a-long-random-string"

# Optional. Set this to enable the DMG's self-service "Register this device"
# flow (POST /agent/register) — hand this code to whoever sets up new Mac
# minis, instead of running `admin/devices` curl commands yourself for each
# one. Much narrower than ADMIN_SECRET: it can only create a new, unassigned
# device row, nothing else. Leave unset to disable self-registration.
DEVICE_SETUP_CODE="change-me-to-a-shareable-code"

# Required for inbound image attachments (POST /agent/attachments) to work.
# Backed by a Railway Volume attached to this service (Railway dashboard ->
# this service -> Settings -> Volumes -> add one, e.g. mounted at /data).
# ATTACHMENTS_DIR should be a path inside that mount (e.g. /data/attachments)
# so uploaded images actually persist across deploys/restarts -- if this
# points somewhere on the container's regular ephemeral filesystem instead,
# every image vanishes on the next deploy.
#
# PUBLIC_URL_BASE is this server's own public URL (same one you use for
# SENDNEW_SERVER_URL elsewhere) -- routes/media.js serves uploaded files back
# out at <PUBLIC_URL_BASE>/media/<filename>, since a Railway volume has no
# public URL of its own.
#
# Leave either unset and sending/receiving text still works fine -- only
# image attachments require this. Only safe with a single server
# instance/replica: a volume isn't shared across horizontally scaled ones.
ATTACHMENTS_DIR="/data/attachments"
PUBLIC_URL_BASE="https://<your-app>.up.railway.app"

PORT=3000
