# Railway will inject DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL="postgresql://user:password@host:5432/sendnew"

# Long random string — used to sign device JWTs.
JWT_SECRET="change-me-to-a-long-random-string"

# Shared secret you (the operator) use to call /admin/* endpoints from your
# own tooling — never expose this to the CRM website or the agent app.
ADMIN_SECRET="change-me-to-a-long-random-string"

# Optional. Set this to enable the DMG's self-service "Register this device"
# flow (POST /agent/register) — hand this code to whoever sets up new Mac
# minis, instead of running `admin/devices` curl commands yourself for each
# one. Much narrower than ADMIN_SECRET: it can only create a new, unassigned
# device row, nothing else. Leave unset to disable self-registration.
DEVICE_SETUP_CODE="change-me-to-a-shareable-code"

# Required for inbound image attachments (POST /agent/attachments) to work.
# Works with any S3-compatible provider -- Cloudflare R2 is the recommended
# default (S3-compatible API, generous free tier, no egress fees):
#   1. Create an R2 bucket in the Cloudflare dashboard, enable public access
#      (or attach a custom domain) so uploaded images are actually loadable
#      by the CRM's browser.
#   2. Create an R2 API token (Account Home > R2 > Manage API Tokens) for
#      S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
#   3. S3_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com
#   4. S3_PUBLIC_URL_BASE is whatever URL that public access/custom domain
#      setup gives you -- this is what gets prefixed onto every uploaded
#      object's key to build the mediaUrl the CRM receives.
# Leave any of these unset and sending/receiving text still works fine --
# only image attachments require this.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="sendnew-attachments"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
S3_PUBLIC_URL_BASE="https://<your-public-bucket-domain>"

PORT=3000
