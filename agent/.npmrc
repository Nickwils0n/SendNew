# These legacy node-gyp target keys are honored by older npm versions but
# silently ignored (with an "Unknown project config" warning) on newer ones —
# confirmed on this project: keytar still built against the system Node's
# ABI despite these being set. Left in place as a harmless best-effort for
# npm versions that do respect them, but don't rely on this alone — the
# `postinstall` script runs `@electron/rebuild` afterward, which forces the
# correct Electron target regardless of npm's behavior. That's the real fix.
runtime=electron
target=31.3.0
disturl=https://electronjs.org/headers
build_from_source=true
