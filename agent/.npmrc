# This app is Electron, which bundles its own Node/V8 — different from
# whatever Node is on your system PATH. Native modules (better-sqlite3) must
# be compiled against Electron's headers/ABI, not the system Node's, or the
# build either fails outright (V8 API mismatch) or produces a binary Electron
# can't load. These settings make node-gyp/prebuild-install target Electron
# automatically on every `npm install` — keep `target` in sync with the
# `electron` version pinned in package.json.
runtime=electron
target=31.3.0
disturl=https://electronjs.org/headers
build_from_source=true
